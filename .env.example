GOVINENA_APP_NAME=GoviNena API
GOVINENA_ENVIRONMENT=development
GOVINENA_LOG_LEVEL=INFO
GOVINENA_CORS_ORIGINS=["http://localhost:3000"]

# Local fallback. Relative SQLite paths resolve from the backend working directory.
DATABASE_URL=sqlite:///./govinena.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
GOVINENA_REASONING_MODE=mock
# Leave empty for the demo. Set both values before creating a live provider.
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase project URL and publishable (or legacy anon) key. No service role key.
GOVINENA_SUPABASE_URL=
GOVINENA_SUPABASE_PUBLISHABLE_KEY=
GOVINENA_SUPABASE_AUDIENCE=authenticated
